# Valores para desarrollo local (versionado, sin secretos reales).
# Para sobrescribir algo localmente usa .env (ignorado por git).

APP_NAME=regalos-lian-api
SERVICE_PORT=7070
SERVICE_WITH_OPEN_API=true

# Database
DB_ADDR=localhost:5433
DB_DATABASE=babyshower
DB_SCHEMAS=babyshower
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# HTTP
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ADMIN_TOKEN=dev-admin-token
RESERVE_RATE_LIMIT=30

# Log: debug | info | warn | error
LOG_LEVEL=debug
